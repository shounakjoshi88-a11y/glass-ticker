{
  "name": "glass-ticker",
  "version": "2.6.0",
  "description": "Glass Ticker - a frameless acrylic desktop market ticker for Windows, macOS and Linux",
  "author": "Shounak",
  "license": "MIT",
  "homepage": "https://github.com/shounakjoshi88-a11y/glass-ticker",
  "repository": {
    "type": "git",
    "url": "https://github.com/shounakjoshi88-a11y/glass-ticker.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64",
    "dist:win": "electron-builder --win portable --x64",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.shounak.glassticker",
    "productName": "GlassTicker",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "widget.html",
      "island.html",
      "icon.png"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.png",
      "category": "public.app-category.finance",
      "darkModeSupport": true,
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Office"
    },
    "portable": {
      "artifactName": "GlassTicker.exe"
    }
  }
}
